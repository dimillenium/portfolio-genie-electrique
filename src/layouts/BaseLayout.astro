---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { EN_READY } from '../i18n/config.mjs';
import { localePath, type RouteKey } from '../i18n/routes';
import { htmlLang, ogLocale, useTranslations, type Lang } from '../i18n/ui';
import { getSingle } from '../lib/content';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  /** Titre de la page (sans le nom du site). Absent sur l'accueil. */
  title?: string;
  description: string;
  route: RouteKey;
  slug?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { lang, title, description, route, slug, noindex = false, ogType = 'website' } = Astro.props;
const t = useTranslations(lang);
const accueil = await getSingle('accueil');

const siteName = accueil.titre;
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${accueil.sousTitre}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og.png'), Astro.site).href;

// Pages EN non traduites : hors index tant que EN_READY est faux
const blockIndex = noindex || (lang === 'en' && !EN_READY);
const alternates =
  EN_READY && route !== 'notfound'
    ? (['fr', 'en'] as const).map((l) => ({
        hreflang: htmlLang[l],
        href: new URL(localePath(l, route, slug), Astro.site).href,
      }))
    : [];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <meta name="theme-color" content="#0b0f14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} · ${accueil.sousTitre}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex flex-col">
    <a href="#contenu" class="skip-link">{t('skip')}</a>
    <Header lang={lang} route={route} slug={slug} siteName={siteName} />
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} siteName={siteName} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 50;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 0.75rem;
  }
</style>
