---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: string;
  /** Icône avant le texte plutôt qu'après. */
  iconFirst?: boolean;
}

const { href, variant = 'secondary', icon, iconFirst = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, className]} {...rest}>
  {icon && iconFirst && <Icon name={icon} class="size-4.5 shrink-0" aria-hidden="true" />}
  <slot />
  {icon && !iconFirst && <Icon name={icon} class="size-4.5 shrink-0" aria-hidden="true" />}
</a>
