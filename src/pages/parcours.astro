---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import Rich from '../components/Rich.astro';
import { getSingle } from '../lib/content';
import { useTranslations } from '../i18n/ui';
import { hasPlaceholder } from '../lib/placeholders.mjs';

const lang = 'fr';
const t = useTranslations(lang);
const { etapes } = await getSingle('parcours');
const description = etapes.map((e) => e.titre).filter((s) => !hasPlaceholder(s)).join(' · ');
---

<BaseLayout lang={lang} route="parcours" title={t('nav.parcours')} description={description}>
  <div class="container-page py-10 sm:py-14">
    <PageTitle title={t('nav.parcours')} />

    <ol class="timeline mt-10 max-w-3xl" role="list">
      {
        etapes.map((etape) => (
          <li class="step" data-etat={etape.etat}>
            <span class="dot" aria-hidden="true" />
            <div class="flex flex-col">
              <h2 class="text-lg leading-snug font-semibold">{etape.titre}</h2>
              <p class="order-first mb-1 font-mono text-xs tracking-wide text-accent uppercase">
                <Rich text={etape.periode} />
              </p>
              <p class="mt-1.5 text-muted">
                <Rich text={etape.description} />
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 2.25rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.4375rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-line) 0%,
      var(--color-line) 70%,
      color-mix(in srgb, var(--color-line) 30%, transparent) 100%
    );
  }
  .step {
    position: relative;
    padding-left: 2.25rem;
  }
  .dot {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }
  .step[data-etat='termine'] .dot {
    background: var(--color-accent);
  }
  .step[data-etat='en-cours'] .dot {
    box-shadow:
      inset 0 0 0 3px var(--color-bg),
      inset 0 0 0 8px var(--color-accent),
      0 0 0 4px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  .step[data-etat='objectif'] .dot {
    border-style: dashed;
    border-color: var(--color-muted);
  }
</style>
