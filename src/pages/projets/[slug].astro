---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import Rich from '../../components/Rich.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { formatDate, getProjets, type Projet } from '../../lib/content';
import { localePath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((projet) => ({ params: { slug: projet.id }, props: { projet } }));
}

interface Props {
  projet: Projet;
}

/** Gabarit attendu : un avertissement au build si une section manque. */
const GABARIT = [
  'Contexte industriel',
  'Objectif',
  'Matériel',
  'Schéma',
  'Implémentation',
  'Résultats',
  'Leçons apprises',
  'Liens',
];

const lang = 'fr';
const t = useTranslations(lang);
const { projet } = Astro.props;
const { title, summary, status, startDate, technologies, cover, coverAlt } = projet.data;
const { Content, headings } = await render(projet);

const sections = headings.filter((h) => h.depth === 2);
const missing = GABARIT.filter((s) => !sections.some((h) => h.text.trim() === s));
if (missing.length > 0) {
  console.warn(`[gabarit] ${projet.id} : section(s) manquante(s) → ${missing.join(', ')}`);
}
---

<BaseLayout lang={lang} route="projets" slug={projet.id} title={title} description={summary} ogType="article">
  <article class="container-page py-8 sm:py-12">
    <a
      href={localePath(lang, 'projets')}
      class="-ml-1 inline-flex items-center gap-1.5 rounded px-1 py-2 text-sm text-muted no-underline hover:text-text"
    >
      <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
      {t('project.back')}
    </a>

    <header class="mt-4 max-w-3xl">
      <StatusBadge status={status} lang={lang} />
      <h1 class="mt-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-text/90">{summary}</p>

      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-[auto_1fr] sm:gap-x-10">
        <div>
          <dt class="eyebrow">{t('project.start')}</dt>
          <dd class="mt-1.5 font-mono">
            {
              startDate instanceof Date ? (
                <time datetime={startDate.toISOString().slice(0, 10)}>{formatDate(startDate, lang)}</time>
              ) : (
                <Rich text={startDate} />
              )
            }
          </dd>
        </div>
        {
          technologies.length > 0 && (
            <div>
              <dt class="eyebrow">{t('project.technologies')}</dt>
              <dd class="mt-1.5">
                <ul class="flex flex-wrap gap-1.5" role="list">
                  {technologies.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="mt-6">
        <ProjectLinks projet={projet} lang={lang} />
      </div>
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280]}
          sizes="(min-width: 68rem) 68rem, 100vw"
          loading="lazy"
          decoding="async"
          class="mt-10 w-full rounded-xl border border-line"
        />
      )
    }

    <div class="mt-10 grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-12">
      {
        sections.length > 0 && (
          <nav aria-labelledby="toc-title" class="self-start lg:sticky lg:top-6">
            <h2 id="toc-title" class="eyebrow">
              {t('project.toc')}
            </h2>
            <ol class="mt-3 grid gap-0.5 text-sm" role="list">
              {sections.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`} class="toc-link">
                    <span class="font-mono text-xs text-accent" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose-project max-w-3xl">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .toc-link {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.3rem 0;
    color: var(--color-muted);
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--color-text);
  }
</style>
