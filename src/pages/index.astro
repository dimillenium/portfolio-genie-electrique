---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rich from '../components/Rich.astro';
import { getSingle } from '../lib/content';

const accueil = await getSingle('accueil');
---

<BaseLayout lang="fr" route="home" description={accueil.accroche}>
  <div class="container-page py-12">
    <h1 class="text-3xl font-semibold"><Rich text={accueil.titre} /></h1>
  </div>
</BaseLayout>
